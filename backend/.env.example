# WhyCode backend environment.
# Copy to .env, fill in real values, then: set -a; source .env; set +a
# (.env is not loaded automatically.)

# GitHub ingestion
WHYCODE_GITHUB_TOKEN=ghp_replace_me
WHYCODE_ARTIFACTS_DIR=../artifacts

# Neo4j (AuraDB or local)
# AuraDB: the username is shown in the console next to the connection URI,
# and newer instances name the default database after the instance id
# (e.g. neo4j+s://15b57912.databases.neo4j.io -> database "15b57912").
WHYCODE_NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
WHYCODE_NEO4J_USER=neo4j
WHYCODE_NEO4J_PASSWORD=replace_me
WHYCODE_NEO4J_DATABASE=neo4j

# OpenAI-compatible extraction model.
# Groq works as-is: base_url https://api.groq.com/openai/v1,
# model openai/gpt-oss-20b.
WHYCODE_LLM_API_KEY=sk-replace_me
WHYCODE_LLM_MODEL=gpt-4o-mini
WHYCODE_LLM_BASE_URL=https://api.openai.com/v1
# Context window of the server model, shown in the UI's token-usage meter.
WHYCODE_LLM_CONTEXT_TOKENS=128000
# Master key encrypting visitors' custom-model API keys at rest in Neo4j.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it an ephemeral key is used and saved custom keys die on restart.
WHYCODE_SECRET_KEY=
# User auth: session-token signing secret (long random string; required
# in production or sessions/pending OTPs die on restart), the Gmail
# address that sends verification codes, and its Google *app password*
# (requires 2-Step Verification on that Google account). Accounts are
# stored in Neo4j when WHYCODE_NEO4J_* is set, else the SQLite file at
# WHYCODE_AUTH_DB.
WHYCODE_AUTH_SECRET=
WHYCODE_GMAIL_ADDRESS=
WHYCODE_GMAIL_APP_PASSWORD=
WHYCODE_AUTH_DB=
WHYCODE_LLM_TIMEOUT_SECONDS=60
WHYCODE_LLM_MAX_OUTPUT_TOKENS=2500
# low/medium/high; Groq's gpt-oss models only. "low" bills fewer reasoning
# tokens, which matters on a 200K-tokens/day free tier.
WHYCODE_LLM_REASONING_EFFORT=

# Published provider caps (defaults: Groq dev plan, gpt-oss-20b/120b).
WHYCODE_LLM_RPM=30
WHYCODE_LLM_RPD=1000
WHYCODE_LLM_TPM=8000
WHYCODE_LLM_TPD=200000

# Optional tighter daily ceilings. Leave empty to allow the whole provider
# cap; set them to leave headroom for a long-lived, repeatedly-run test suite.
WHYCODE_LLM_BUDGET_REQUESTS=
WHYCODE_LLM_BUDGET_TOKENS=
# Ledger of requests/tokens per model per UTC day. Defaults to
# $WHYCODE_ARTIFACTS_DIR/intent/llm_budget.json.
WHYCODE_LLM_BUDGET_FILE=

# Opt-in live LLM test (one tiny request). Leave empty to skip.
WHYCODE_TEST_LLM=
WHYCODE_TEST_LLM_API_KEY=
WHYCODE_TEST_LLM_MODEL=
WHYCODE_TEST_LLM_BASE_URL=

# Opt-in live Neo4j tests (leave empty to skip)
WHYCODE_TEST_NEO4J_URI=
WHYCODE_TEST_NEO4J_USER=
WHYCODE_TEST_NEO4J_PASSWORD=
WHYCODE_TEST_NEO4J_DATABASE=
