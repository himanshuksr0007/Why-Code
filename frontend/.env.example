# Copy to .env.local and adjust as needed.
# (Create React/Next apps read .env.local automatically; .env.example is committed.)

# Which answer-service transport to use:
#   mock — bundled fixtures in src/lib/mock/, so the UI runs with no backend.
#   http — the live FastAPI answer service (Components 5).
NEXT_PUBLIC_API_MODE=mock

# Base URL of the answer service. Only used when NEXT_PUBLIC_API_MODE=http.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# The repository the UI asks about.
NEXT_PUBLIC_REPO=encode/httpx
