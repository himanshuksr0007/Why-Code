# Copy to .env.local and adjust as needed.
# (Create React/Next apps read .env.local automatically; .env.example is committed.)

# Which answer-service transport to use:
#   mock — bundled fixtures in src/lib/mock/, so the UI runs with no backend.
#   http — the FastAPI answer service (default).
NEXT_PUBLIC_API_MODE=http

# Base URL of the answer service. Only used when NEXT_PUBLIC_API_MODE=http.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# CSP defaults to report-only. Set to enforce after checking the deployed auth and Ask flows.
# WHYCODE_CSP_MODE=enforce

# Clerk sign-in (email, Google, GitHub). The publishable key is public
# and safe to expose; the secret key is server-side only and must match
# the WHYCODE_CLERK_* pair on the backend. Without the publishable key
# the auth pages render in their no-sign-in state.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The repository the UI asks about.
NEXT_PUBLIC_REPO=encode/httpx
